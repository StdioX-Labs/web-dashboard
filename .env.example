# Organizer web dashboard. All of these are read server-side only;
# none may be NEXT_PUBLIC_ (they would be baked into the browser bundle).

# --- Keycloak (realm soa, confidential client soa-dashboard-web) ---
# Public issuer: the `iss` claim, and where the browser is sent to sign in/out.
KEYCLOAK_ISSUER=https://staging-auth.soldoutafrica.com/realms/soa
# Same realm from inside the cluster: token exchange, refresh and JWKS.
# Optional; defaults to KEYCLOAK_ISSUER.
KEYCLOAK_INTERNAL_ISSUER=http://keycloak.staging.svc:8080/realms/soa
# client_credentials endpoint for the public signup / lead routes.
# Optional; defaults to <KEYCLOAK_INTERNAL_ISSUER>/protocol/openid-connect/token.
KEYCLOAK_TOKEN_URL=http://keycloak.staging.svc:8080/realms/soa/protocol/openid-connect/token
KEYCLOAK_CLIENT_ID=soa-dashboard-web
# From Secret keycloak-clients, key soa-dashboard-web.
KEYCLOAK_CLIENT_SECRET=

# Encrypts the session cookie. 32+ random bytes, e.g. `openssl rand -base64 48`.
# Changing it signs everyone out.
AUTH_SECRET=

# The dashboard's own public URL (no trailing slash). Redirect URI is
# $APP_URL/api/auth/callback; post-logout redirect is $APP_URL/.
APP_URL=https://staging-dashboard.soldoutafrica.com

# --- SoldOut core API (including /api/v1). Defaults to production. ---
SOLDOUT_API_BASE_URL=http://core:1122/api/v1

# --- Optional ---
# Organizer assistant (Claude). Without the key the assistant reports it is not set up.
ANTHROPIC_API_KEY=
ANTHROPIC_WORKSPACE_ID=
# Meta Conversions API for /get-started leads.
META_CAPI_TOKEN=
META_TEST_EVENT_CODE=
# Rate limiting for the step-up OTP route (defaults shown).
AUTH_FREE_ATTEMPTS=50
AUTH_BACKOFF_BASE_MS=5000
AUTH_BACKOFF_MAX_MS=900000
AUTH_BACKOFF_RESET_MS=3600000
